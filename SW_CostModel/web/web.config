<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Central Automation estimator.

  Needs on the server (all available offline from the Windows Server installation media):
    - IIS with: Static Content, Default Document, ASP.NET 4.x (4.5 or later), Windows Authentication
    - An application pool: .NET CLR v4.0, Integrated pipeline
  The database connection (CCCConString) is in the connectionStrings section below: edit it there.
  Turn on Windows Authentication (and turn off Anonymous) in IIS Manager > Authentication;
  those settings are locked at server level, so they cannot be set here.
  See docs\DEPLOYMENT_IIS.md for the full steps.
-->
<configuration>

  <!-- Database connection. All database access (the pages and the JSON API) goes through dbClassSql (App_Code\dbClassSql.cs, via App_Code\Db.cs), which reads CCCConString.
       Windows authentication: the IIS application pool account logs in (run database\01_create_database_and_login.sql with that account).
       For a SQL Server login use: User ID=...;Password=...  instead of Integrated Security=True. -->
  <connectionStrings>
    <add name="CCCConString" providerName="System.Data.SqlClient"
         connectionString="Data Source=localhost;Initial Catalog=CentralAutomationEstimator;Integrated Security=True;Connect Timeout=15;Application Name=CentralAutomationEstimator" />
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="8192" enableVersionHeader="false" />
    <authentication mode="Windows" />
    <customErrors mode="RemoteOnly" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="Off" />
  </system.web>

  <!-- C# 6/7 compiler (dbClassSql.cs needs it; the built-in compiler is C# 5).
       Needs bin\Microsoft.CodeDom.Providers.DotNetCompilerPlatform.dll and bin\roslyn, which a publish copies. -->
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
    </compilers>
  </system.codedom>

  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="project_registry.aspx" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Fonts are served from this site, no internet needed. remove first so this works whether or not the server already maps .woff2 -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Browsers check for a newer page, script and style sheet on every visit, so updates show at once -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <!-- Everything loads from this site only: no CDN, no Google Fonts, no internet -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- never serve a config folder -->
          <add segment="config" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
