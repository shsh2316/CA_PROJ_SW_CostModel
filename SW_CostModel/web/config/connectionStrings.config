<?xml version="1.0" encoding="utf-8"?>
<!--
  Database connection for the Central Automation estimator.
  This is the only file to edit when the database server or name changes.
  web.config reads it through <connectionStrings configSource="config\connectionStrings.config" />.
  IIS never serves this folder to browsers (see hiddenSegments in web.config).

  Pick ONE of the connection strings below and keep the name "CentralAutomationEstimator".

  A. Windows authentication (recommended). The IIS application pool account logs in to SQL Server.
     Run database\01_create_database_and_login.sql with that account first.
       Data Source   SQL Server machine name, or MACHINE\INSTANCE for a named instance
                     (use . or (local) when SQL Server is on the web server itself)
       Initial Catalog  the database name used in the SQL scripts

  B. SQL Server login. Use only if Windows authentication is not possible. The password is
     stored in plain text here, so restrict who can read this folder on the server, or encrypt
     the section:
       aspnet_regiis -pef "connectionStrings" "C:\inetpub\CentralAutomationEstimator"
-->
<connectionStrings>
  <add name="CentralAutomationEstimator"
       providerName="System.Data.SqlClient"
       connectionString="Data Source=localhost;Initial Catalog=CentralAutomationEstimator;Integrated Security=True;Connect Timeout=15;Application Name=CentralAutomationEstimator" />

  <!-- B. SQL Server login (remove the line above and uncomment this one):
  <add name="CentralAutomationEstimator"
       providerName="System.Data.SqlClient"
       connectionString="Data Source=SQLSERVER01;Initial Catalog=CentralAutomationEstimator;User ID=estimator_app;Password=CHANGE_ME;Connect Timeout=15;Application Name=CentralAutomationEstimator" />
  -->
</connectionStrings>
