<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>

  <!-- Database connection. All database access (the pages and the JSON API) goes through dbClassSql
       (SW_CostModel\web\App_Code\dbClassSql.cs, via Db.cs), which reads CCCConString.
       Windows authentication: the IIS application pool account logs in to SQL Server.
       For a SQL Server login use User ID=...;Password=... instead of Integrated Security=True
       (values with ; or " in them: Password="..."; & and < are written &amp; and &lt; in this file). -->
  <connectionStrings>
    <add name="CCCConString" providerName="System.Data.SqlClient"
         connectionString="Data Source=localhost;Initial Catalog=CA_PROJ_COST_MODEL;Integrated Security=True;Connect Timeout=15;Application Name=CentralAutomationEstimator" />
  </connectionStrings>

  <!-- The one shared login (Default.aspx is the login page; LoginModule checks every request).
       Any user name is accepted; LoginPasswordSha256 is the SHA-256 (hex) of the password, so the password is not in this file.
       To change the password, in PowerShell:
         $b=[Text.Encoding]::UTF8.GetBytes('NEW PASSWORD'); -join ([Security.Cryptography.SHA256]::Create().ComputeHash($b)|%{$_.ToString('x2')})
       and paste the result below. Everyone who signs in is an admin (costs, masters, Excel upload, verification).
       AllowSelfVerification: with one shared password nobody else can verify an entry, so a person may verify their own.
       LoginHours: how long a sign-in lasts. -->
  <appSettings>
    <add key="LoginPasswordSha256" value="aa4dd161368601247932398ae2b8652ef7a19230e13df49175a603380afb666f" />
    <add key="AllowSelfVerification" value="true" />
    <add key="LoginHours" value="8" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" enableVersionHeader="false" />
    <!-- Sign-in is done by LoginModule (below), not by IIS or ASP.NET: in IIS (or IIS Express) leave Anonymous
         Authentication enabled and Windows Authentication disabled. -->
    <authentication mode="None" />
    <customErrors mode="RemoteOnly" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="Off" />
  </system.web>

  <system.webServer>
    <modules>
      <add name="LoginModule" type="LoginModule, CA_PROJECT_COSTING_MODEL" />
    </modules>

    <!-- The site root opens Default.aspx, the login page; after signing in it goes to /SW_CostModel/web/project_registry.aspx -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Fonts are served from this site, no internet needed. remove first so this works whether or not the server already maps .woff2 -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <!-- Everything loads from this site only: no CDN, no Google Fonts, no internet -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>